-- ------------------------------
-- OPTION
-- ------------------------------

OPTION IMPORT;

-- ------------------------------
-- FUNCTIONS
-- ------------------------------

DEFINE FUNCTION fn::default_relation($board: record<boards>) { LET $list = (SELECT VALUE id FROM breakers WHERE board = $board.id AND name != 'Q0'); LET $root = (SELECT VALUE id FROM ONLY breakers WHERE board = $board.id AND name = 'Q0' LIMIT 1); FOR $out IN $list { INSERT RELATION IGNORE INTO connects { in: $root, out: $out } }; } PERMISSIONS FULL;
DEFINE FUNCTION fn::get_board_from_room($name: string, $room: { id: record<electric_rooms> }) -> record<boards> { RETURN (SELECT VALUE id FROM ONLY boards WHERE name = $name AND room = $room.id LIMIT 1) } PERMISSIONS FULL;

-- ------------------------------
-- BUCKETS
-- ------------------------------

DEFINE BUCKET draft BACKEND 'memory' PERMISSIONS FULL;
DEFINE BUCKET images BACKEND 'file:///C:/Users/User/gits/ee_map/data/bucket' PERMISSIONS WHERE $auth.id != NONE;

-- ------------------------------
-- TABLE: __entity
-- ------------------------------

DEFINE TABLE __entity TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;

DEFINE FIELD OVERWRITE key ON __entity TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE ns ON __entity TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updated_at ON __entity TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE val ON __entity TYPE any PERMISSIONS FULL;

DEFINE INDEX by_ns_key ON __entity FIELDS ns, key UNIQUE;


