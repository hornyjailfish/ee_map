-- ------------------------------
-- TABLE: transformers
-- ------------------------------

DEFINE TABLE transformers TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE name ON transformers TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE room ON transformers TYPE record<electric_rooms> PERMISSIONS FULL;

DEFINE INDEX unique_trans_name ON transformers FIELDS name, room UNIQUE;


-- ------------------------------
