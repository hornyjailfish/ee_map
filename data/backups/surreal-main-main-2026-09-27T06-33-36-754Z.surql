-- ------------------------------
-- TABLE: electric_rooms
-- ------------------------------

DEFINE TABLE electric_rooms TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE geometry ON electric_rooms TYPE geometry<polygon> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE level ON electric_rooms TYPE record<levels> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON electric_rooms TYPE string PERMISSIONS FULL;

DEFINE INDEX unique_electric_room_name ON electric_rooms FIELDS name UNIQUE;


