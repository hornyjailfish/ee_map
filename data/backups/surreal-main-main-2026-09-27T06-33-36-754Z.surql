-- ------------------------------
-- TABLE: rents
-- ------------------------------

DEFINE TABLE rents TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE geometry ON rents TYPE geometry<polygon> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE level ON rents TYPE record<levels> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON rents TYPE string PERMISSIONS FULL;

DEFINE INDEX unique_geometry ON rents FIELDS geometry UNIQUE;
DEFINE INDEX unique_rent_name ON rents FIELDS name, level UNIQUE;


