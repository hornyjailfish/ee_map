-- ------------------------------
-- TABLE: breakers
-- ------------------------------

DEFINE TABLE breakers TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE board ON breakers TYPE record<boards> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE description ON breakers TYPE string | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON breakers TYPE string ASSERT string::matches($value, '^(Q|K)[0-9]+(\\.[0-9]+)?$') PERMISSIONS FULL;
DEFINE FIELD OVERWRITE `value` ON breakers TYPE number | none PERMISSIONS FULL;

DEFINE INDEX unique_breakers ON breakers FIELDS name, board UNIQUE;


