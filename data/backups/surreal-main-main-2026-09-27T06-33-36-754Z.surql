-- ------------------------------
-- TABLE: connects
-- ------------------------------

DEFINE TABLE connects TYPE RELATION IN breakers | transformers OUT breakers | rents SCHEMALESS PERMISSIONS FULL;

DEFINE FIELD OVERWRITE cable ON connects TYPE string | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON connects TYPE record<breakers | transformers> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON connects TYPE record<breakers | rents> PERMISSIONS FULL;

DEFINE INDEX one_edge ON connects FIELDS in, out UNIQUE;


