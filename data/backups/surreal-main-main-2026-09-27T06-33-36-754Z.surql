-- ------------------------------
-- TABLE: shops
-- ------------------------------

DEFINE TABLE shops TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE aliases ON shops TYPE array<string> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE aliases.* ON shops TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE area ON shops TYPE record<rents> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON shops TYPE string PERMISSIONS FULL;

DEFINE INDEX unique_shops ON shops FIELDS area UNIQUE;


