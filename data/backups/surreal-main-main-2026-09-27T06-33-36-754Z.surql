-- TABLE: rooms
-- ------------------------------

DEFINE TABLE rooms TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE geometry ON rooms TYPE geometry<polygon> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE level ON rooms TYPE record<levels> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON rooms TYPE none | string PERMISSIONS FULL;



