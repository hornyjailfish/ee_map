-- ------------------------------
-- TABLE: boards
-- ------------------------------

DEFINE TABLE boards TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE name ON boards TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE room ON boards TYPE record<electric_rooms> PERMISSIONS FULL;

DEFINE INDEX unique_boards_per_room ON boards FIELDS name, room UNIQUE;


