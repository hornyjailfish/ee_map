33096545, 178.55228889123657], [338.29802535678925, 174.73883851107547], [335.88189416106326, 174.75886605406174], [335.88134934484935, 176.87261914269936], [334.6488046539664, 176.87314406481934], [334.64268994236056, 178.57208909748982], [338.3440833096545, 178.55228889123657]]] }, id: electric_rooms:xgkj1ekgj0voxfqb29dc, level: levels:2, name: '2.2' } ];

-- ------------------------------
-- TABLE: embeddings
-- ------------------------------

DEFINE TABLE embeddings TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE description ON embeddings TYPE string | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding_model ON embeddings TYPE string | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE embedding_status ON embeddings TYPE string | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE image ON embeddings TYPE string | none ASSERT $value = NONE OR <regex> '^f"images:/.*"$' = $value PERMISSIONS FULL;
DEFINE FIELD OVERWRITE image_embedding ON embeddings TYPE array<float> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE image_embedding.* ON embeddings TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE level ON embeddings TYPE record<levels> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE marker ON embeddings TYPE geometry<point> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE shop ON embeddings TYPE record<shops> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE text_embedding ON embeddings TYPE array<float> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE text_embedding.* ON embeddings TYPE float PERMISSIONS FULL;
DEFINE FIELD OVERWRITE zone ON embeddings TYPE record<zones> | none PERMISSIONS FULL;



-- ------------------------------
-- TABLE DATA: embeddings
-- ------------------------------

INSERT [ { description: '-1 Этаж, перед банкоматами, днс', embedding_model: 'jina-embeddings-v5-omni-nano-retrieval', embedding_status: 'failed', id: embeddings:5skafx6he04cpr0rjzd2, level: levels:-1, marker: (155.34872839140326, 66.57659361694024), zone: zones:4pyr97ne5v291cvm77u1 }, { description: '-1 Этаж, банкоматы, раздвижные двери, выход на парковку, вывеска над раздвижными дверями, у дежурки', embedding_model: 'jina-embeddings-v5-omni-nano-retrieval', embedding_status: 'pending', id: embeddings:fa5rx51axq16k3cqil7k, level: levels:-1, marker: (155.17030962988642, 68.86711894068691), zone: zones:4pyr97ne5v291cvm77u1 } ];

-- ------------------------------
-- TABLE: levels
-- ------------------------------

DEFINE TABLE levels TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD OVERWRITE geometry ON levels TYPE geometry<multiline> | geometry<polygon> | none PERMISSIONS FULL;
DEFINE FIELD OVERWRITE geometry.* ON levels TYPE geometry<line> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON levels TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE ord ON levels TYPE int DEFAULT 1 PERMISSIONS FULL;



-- ------------------------------
