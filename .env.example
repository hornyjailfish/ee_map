SURREALDB_HOST=http_db

SURREALDB_NAMESPACE=main
SURREALDB_NAME=main
SURREALDB_USER=user
SURREALDB_PASSWORD=password
SURREALDB_AUTH_LEVEL=root/ns/record

# Which app_config:<id> row to use when no sdb_app_config cookie is set.
# Seed still writes app_config:main (INSERT IGNORE). Use /config to switch or create other ids.
APP_CONFIG_ID=main

# for bucket setup
SURREAL_CAPS_ALLOW_EXPERIMENTAL=files
SURREAL_BUCKET_FOLDER_ALLOWLIST=C:\Users\User\app\data\bucket
ORIGIN=""

# embedding app
FASTAPI_PORT=8030
